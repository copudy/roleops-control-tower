    "crm-access": {
      "sha256": "7b4c4734be428ba1850c98bd49fb2f01f183056584d8229c24579f3e139cb99f",
      "policy_version": "2026.1",
      "lifecycle_status": "current",
      "scope": "policy",
      "allowed_roles": [
        "support",
        "it",
        "supervisor"
      ],
      "body": "CRM 系統存取申請：員工需說明工作目的與使用期間，由部門主管核准。助理只能建立待核准申請，不能直接授予權限。CRM 帳密不可分享。核准後由資訊單位依核准內容開通。\n"
    },
    "operations-report": {
      "sha256": "3ca08ae8b57ae47506bb9da72a7d0c33438460f28af06f62d83cbf27aea89575",
      "policy_version": "2026.9",
      "lifecycle_status": "current",
      "scope": "operations",
      "allowed_roles": [
        "supervisor"
      ],
      "body": "公司九月營運月報（合成資料）：客訴案件增加 15%，平均回覆時間由 8 小時增加至 12 小時，交接漏件 6 件。可評估知識更新與交接檢查流程是否一致；僅提供觀察及待驗證假設，不代替經營決策。財務報表系統申請仍需主管核准。\n"
    },
    "support-handover": {
      "sha256": "68208472491c9aa272439b626c50acbd6bde6e97051d4b50b00427f0472ffb26",
      "policy_version": "2026.1",
      "lifecycle_status": "current",
      "scope": "handover",
      "allowed_roles": [
        "support",
        "supervisor"
      ],
      "body": "前任客服專員交接工作資料：一、未結案件清單；二、重點客戶聯絡窗口；三、每日交班檢查表；四、已核准退款紀錄；五、常見客訴 FAQ。資料為合成教材，不包含真實個資。\n",
      "allowed_departments": [
        "客服部"
      ],
      "allowed_job_titles": [
        "客服專員",
        "客服主管"
      ]
    },
    "support-sop": {
      "sha256": "ec194a48e19a66a11e83ce83e5eeb5989a270b0b5cdfe30c6ceb434f353a7b1a",
      "policy_version": "2026.1",
      "lifecycle_status": "current",
      "scope": "support",
      "allowed_roles": [
        "support",
        "supervisor"
      ],
      "body": "客服客訴流程：先確認案件編號及客戶問題，記錄問題類型與處理時限。退款需求轉交主管核准，未核准不得承諾退款。每天於交班前更新 CRM 案件狀態。\n"
    },
    "it-sop": {
      "sha256": "e83d50f95407e18b29765df35452a7177916e93d24cadca20edd49ea7dcab203",
      "policy_version": "2026.1",
      "lifecycle_status": "current",
      "scope": "it",
      "allowed_roles": [
        "it",
        "supervisor"
      ],
      "body": "資訊支援 SOP：確認錯誤發生時間、trace_id 與服務範圍。MCP Timeout 先查申請識別碼，結果不明時使用相同防重複鍵重試。避免以不同鍵重送造成重複申請。\n"
    },
